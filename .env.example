# ---------------------------------------------------------------------------
# Google OAuth credentials for the DRIVE OWNER (you).
# Create at https://console.cloud.google.com/apis/credentials
#   -> Create credentials -> OAuth client ID -> Web application
#   -> Authorised redirect URI: http://localhost:5555/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Produced by `npm run auth`. Grants full access to your Drive — never commit it.
GOOGLE_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Where uploads land. Leave FOLDER_ID blank to auto-create a folder by name.
# ---------------------------------------------------------------------------
DRIVE_FOLDER_NAME=Shared Uploads
# DRIVE_FOLDER_ID=

# ---------------------------------------------------------------------------
# Guard rails. The upload page is public, so these matter.
# ---------------------------------------------------------------------------
# Visitors must supply this to upload. Blank = anyone with the link can upload.
ACCESS_CODE=
# Unlocks /api/quota and /api/files. Blank = those routes stay disabled.
OWNER_CODE=
MAX_FILE_MB=512
MAX_UPLOADS_PER_HOUR=30
# Comma separated, e.g. "pdf,png,jpg". Blank = any type.
ALLOWED_EXTENSIONS=

SITE_TITLE=Upload to my Drive
PORT=3000

# ---------------------------------------------------------------------------
# Supabase — upload log, owner dashboard, durable rate limiting.
# Optional: leave blank and the portal still works, just without tracking.
#
# The service-role key is SECRET (it bypasses every row-level security rule).
# Copy it from: Supabase dashboard -> Project Settings -> API -> service_role
# ---------------------------------------------------------------------------
SUPABASE_URL=https://fnefzgpbnjjgefaktlwj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Telegram bot (optional). Token from @BotFather -> /newbot
# Run it with: npm run bot
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Shown to users when a file is too big for Telegram's 20 MB bot limit.
SITE_URL=
